{
  "name": "aura-native",
  "version": "1.0.0",
  "description": "AURA Music Player — Electron shell with native WASAPI audio output",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "naudiodon": "^2.3.6",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.parsa.aura",
    "productName": "AURA",
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallDirectory": true, "createDesktopShortcut": true },
    "files": ["index.html", "main.js", "preload.js"],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/naudiodon/**"]
  }
}
